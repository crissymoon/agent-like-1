# XcaliburLiteMCP configuration. Copy to .env and edit as needed.
# Every entry is optional: each one defaults to the value described beside it,
# so a checkout runs with no .env at all.

# Local model (llama.cpp / GGUF). Defaults to models/ in the repository this
# package lives in, for the file named below. Point it anywhere with:
# XCALIBUR_MODEL=<repo>/models/gemma-agent-coding-Q4_K_M.gguf
XCALIBUR_CTX=32768
XCALIBUR_NGL=99
XCALIBUR_PORT=8080

# Identity and the startup splash. The version is stamped into the banner's
# -{$the_version}- placeholder and reported by the MCP handshake, so the two
# cannot disagree. Set XCALIBUR_SPLASH=0 to boot without the animation.
XCALIBUR_VERSION=1.1.0
XCALIBUR_SPLASH=1
# XCALIBUR_SPLASH_FILE=<repo>/on-load.txt
XCALIBUR_SPLASH_FPS=30
# Seconds for the reveal to travel the full height of the art, and the pause on
# the completed frame before the prompt takes over.
XCALIBUR_SPLASH_REVEAL=1.2
XCALIBUR_SPLASH_HOLD=0.4

# The workspace: the one folder the terminal navigates and the agent reads and
# edits. Defaults to workspace/ beside this package, so the terminal opens on
# the working folder rather than on the repository around the harness. The
# harness keeps its job records, snapshots, shadow copies and test sandboxes in
# a hidden .xcalibur/ folder inside the workspace; nothing outside the
# workspace is ever listed, read or edited.
# XCALIBUR_WORKSPACE=/path/to/project

# Review dashboard
XCALIBUR_DASHBOARD_PORT=8420

# Context safety
XCALIBUR_CONTEXT_CHARS=24000
XCALIBUR_CHUNK_CHARS=6000
XCALIBUR_CHUNK_OVERLAP=20

# Interpretation and navigation
# Closest-neighbour score below which a typed name is reported as unmatched.
XCALIBUR_FUZZY_MIN=0.55
# Lines shown by the `cat` navigator command before it truncates.
XCALIBUR_CAT_LINES=400
# The navigator is confined to the workspace and a value outside it is refused,
# so this only ever narrows the view to a folder inside it.
# XCALIBUR_NAV_ROOT=<workspace>/src

# Agent transparency
XCALIBUR_SHOW_THINKING=1
XCALIBUR_STREAM=1

# Generation budgets. The first pass is kept tight so a compliant answer returns
# in seconds; every later pass can be asked to write a whole file, so it gets the
# write budget rather than the smaller summarise budget. A write budget smaller
# than one file is what cut a second file off mid-call.
XCALIBUR_MAX_TOKENS=4096
XCALIBUR_FIRST_PASS_TOKENS=2048
XCALIBUR_RETRY_TOKENS=8192
XCALIBUR_WRITE_TOKENS=8192
# Direct chat (/chat). The reply budget, how many exchanges the chat keeps
# before dropping the oldest, where a transcript is written when the platform
# has no clipboard tool, and whether leaving chat mode offers to copy.
XCALIBUR_CHAT_TOKENS=4096
XCALIBUR_CHAT_TURNS=40
XCALIBUR_CHAT_COPY_DIR=
XCALIBUR_CHAT_COPY_PROMPT=1
XCALIBUR_FIRST_PASS_TIMEOUT=420

# Minimal-code bias: a written file above this many lines draws a corrective
# nudge, and a document wrapper left after the nudge is stripped.
XCALIBUR_MINIMAL_LINES=40

# Linting and surgical repair
XCALIBUR_LINT=1
XCALIBUR_LINT_TIMEOUT=60
XCALIBUR_REPAIR_ATTEMPTS=2
