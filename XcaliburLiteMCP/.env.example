# XcaliburLiteMCP configuration. Copy to .env and edit as needed.
# Every entry is optional: each one defaults to the value described beside it,
# so a checkout runs with no .env at all.

# Local model (llama.cpp / GGUF). Defaults to models/ under the target root,
# for the file named below. Point it anywhere with:
# XCALIBUR_MODEL=<repo>/models/gemma-agent-coding-Q4_K_M.gguf
XCALIBUR_CTX=32768
XCALIBUR_NGL=99
XCALIBUR_PORT=8080

# The codebase the agent may read and propose edits against. Defaults to the
# parent of this package, which is the repository the lite agent lives in.
# XCALIBUR_TARGET_ROOT=<repo>

# Review dashboard
XCALIBUR_DASHBOARD_PORT=8420

# Context safety
XCALIBUR_CONTEXT_CHARS=24000
XCALIBUR_CHUNK_CHARS=6000
XCALIBUR_CHUNK_OVERLAP=20
